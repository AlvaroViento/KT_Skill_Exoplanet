{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_report.schema.json",
  "title": "QuickSketchReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_mode", "review_goal", "mode_basis", "scheme_model", "visible_evidence", "overall_judgment", "findings", "external_fact_checks", "next_actions", "mode_specific"],
  "properties": {
    "input_mode": {"enum": ["text_concept", "board_draft", "final_sheet"]},
    "review_goal": {"enum": ["develop", "revise", "retrospective", "benchmark"]},
    "mode_basis": {"type": "string", "minLength": 1},
    "scheme_model": {"$ref": "scheme_model.schema.json"},
    "visible_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_type", "content", "location", "visibility", "confidence", "supports"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["text", "image_text", "diagram", "interface", "illustration", "layout"]},
          "content": {"type": "string"},
          "location": {"type": ["string", "null"]},
          "visibility": {"enum": ["explicit", "inferred", "unreadable", "absent"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "supports": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "overall_judgment": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "external_fact_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "status", "summary", "sources"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "partially_supported", "conflicted", "unsupported", "not_verified"]},
          "summary": {"type": "string"},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "publisher", "url", "accessed_date", "source_type"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "publisher": {"type": "string", "minLength": 1},
                "url": {"type": "string", "minLength": 1},
                "accessed_date": {"type": "string", "format": "date"},
                "source_type": {"enum": ["official", "standard", "paper", "professional", "company", "community"]}
              }
            }
          }
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mode_specific": {"type": "object"}
  }
}
